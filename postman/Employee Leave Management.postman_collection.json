{
  "info": {
    "_postman_id": "93bd1c14-b90a-4f9c-988e-24ce02900001",
    "name": "Employee Leave Management - Set C",
    "description": "ITUE301 Set C API tests. Run a login request first; its script stores the Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "leaveTypeId", "value": "PASTE_A_LEAVE_TYPE_ID" },
    { "key": "leaveId", "value": "" }
  ],
  "item": [
    {
      "name": "Login - Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - HR",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"hr@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List Leave Types",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/leave-types"
      }
    },
    {
      "name": "Create Leave - 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('leaveId', pm.response.json().leave._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"leaveTypeId\": \"{{leaveTypeId}}\",\n  \"fromDate\": \"2026-09-01\",\n  \"toDate\": \"2026-09-02\",\n  \"reason\": \"Family function\"\n}"
        },
        "url": "{{baseUrl}}/leaves"
      }
    },
    {
      "name": "My Leaves",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/leaves/my"
      }
    },
    {
      "name": "All Leaves - Manager or HR",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/leaves"
      }
    },
    {
      "name": "Approve Leave - Manager or HR",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}" },
        "url": "{{baseUrl}}/leaves/{{leaveId}}/status"
      }
    },
    {
      "name": "Validation Failure - Invalid Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"cancelled\"\n}" },
        "url": "{{baseUrl}}/leaves/{{leaveId}}/status"
      }
    }
  ]
}
